# 复制为 .env 后填写真实值，勿提交 .env

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=onlinepractice

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
JUDGE_WORKERS=5

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_BUCKET_AVATAR=oj-avatar
MINIO_BUCKET_CODE=oj-code
STORAGE_BACKEND=minio

JWT_SECRET=change-me-in-production

# ==================== 邮件服务 ====================
# 后端类型: smtp (当前仅支持 SMTP)
EMAIL_BACKEND=smtp
# 快捷预设: qq | 163 | gmail | outlook | aliyun | custom
# 设置预设后自动填充 SMTP_HOST / SMTP_PORT，可被显式配置覆盖
EMAIL_PROVIDER=qq
# 发件人显示名称
EMAIL_SENDER_NAME=OnlineJudge

# ---- SMTP 发送配置 ----
# 用预设时以下两行可省略，预设自动补全
SMTP_HOST=smtp.qq.com
SMTP_PORT=587

# 发件邮箱地址和授权码（必填）
# QQ邮箱授权码获取：设置 → 账户 → POP3/SMTP服务 → 开启 → 生成授权码
# 163邮箱授权码获取：设置 → POP3/SMTP/IMAP → 开启 → 新增授权码
# Gmail：开启两步验证 → 应用专用密码
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_authorization_code

# 发件人地址，默认同 SMTP_USER
# SMTP_FROM=

# ---- 各服务商 SMTP 参考 ----
# QQ邮箱    smtp.qq.com         587/465   SSL:465  STARTTLS:587
# 163邮箱   smtp.163.com        465/25    SSL:465
# Gmail     smtp.gmail.com      587/465   STARTTLS:587  SSL:465
# Outlook   smtp-mail.outlook.com 587     STARTTLS:587
# 阿里企业  smtp.mxhichina.com  465/25    SSL:465
# 自定义    <your-smtp-host>    <port>

# ---- 其他协议说明（接收邮件，本系统暂未使用）----
# IMAP：用于接收邮件，端口 993(SSL) / 143
# POP3：用于接收邮件，端口 995(SSL) / 110
# Exchange：可使用 SMTP 发送（见下方 Outlook 预设）+ EWS 协议收发
# CardDAV：通讯录同步，与邮件发送无关
# 如需接收邮件功能（如邮件找回密码），联系开发者扩展
